  <decision id="number-nature-task" name="number nature">
    <decisionTable id="DecisionTable_13b79jo">
      <input id="Input_1" label="user input" camunda:inputVariable="input1">
        <inputExpression id="InputExpression_1" typeRef="integer">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_1" label="nature" name="nature" typeRef="string" />
      <rule id="DecisionRule_045db67">
        <inputEntry id="UnaryTests_0wumgwr">
          <text>0</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_006ocvs">
          <text>"ZERO"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1uihql9">
        <inputEntry id="UnaryTests_1n1w3yc">
          <text>&lt;0</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0o0cpfh">
          <text>"NEGATIVE"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1pcxn5p">
        <inputEntry id="UnaryTests_13mxque">
          <text>&gt;0</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_04tzbml">
          <text>"POSITIVE"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
